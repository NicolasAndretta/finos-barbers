# ─── SUPABASE ────────────────────────────────────────────────────────────────
# Encontrás estos valores en: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ─── BASE DE DATOS (solo para los scripts de scripts/) ───────────────────────
# Conexión directa a Postgres. La app no la usa: solo migrate.mjs,
# exportar-esquema.mjs y preparar-desarrollo.mjs.
#   - Supabase local (desarrollo): postgresql://postgres:postgres@127.0.0.1:54322/postgres
#   - Supabase en la nube: botón "Connect" → "Session pooler" → copiá la URI y
#     reemplazá [YOUR-PASSWORD] por la contraseña de la base.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ¿A qué base apunta este archivo? desarrollo | produccion
#   desarrollo → .env.local            (Supabase local en la PC: se construye y se prueba)
#   produccion → .env.produccion.local (proyecto finos-barbers: demo, web de 369 y producto)
# Los scripts que ESCRIBEN en la base solo corren solos si dice "desarrollo".
# Para producción hay que pedirlo a propósito con --produccion.
SUPABASE_ENTORNO=desarrollo

# Cuenta de admin de prueba que crea scripts/preparar-desarrollo.mjs.
# Solo en el archivo de desarrollo. Inventá un mail y una clave de prueba.
DEV_ADMIN_EMAIL=admin.prueba@example.com
DEV_ADMIN_PASSWORD=una_clave_de_prueba

# ─── RESEND (emails transaccionales) ─────────────────────────────────────────
# Creá tu API key en: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key

# ─── MERCADO PAGO CONNECT (OAuth) ────────────────────────────────────────────
# Cada local conecta SU cuenta desde su panel (Cobros) y cobra en ella. Desde
# la Fase 4 no hay "token de respaldo": un local sin cuenta conectada no cobra
# online (si tenés MERCADOPAGO_ACCESS_TOKEN de antes, borrá la línea).
# La aplicación de Mercado Pago es una sola, la de la PLATAFORMA:
# Panel de developers → Tus integraciones → Crear aplicación → Credenciales.
# Redirect URI a registrar en esa aplicación: <NEXT_PUBLIC_APP_URL>/api/mp/oauth/callback
MP_CLIENT_ID=your_mp_application_id
MP_CLIENT_SECRET=your_mp_client_secret
# Clave para verificar la firma de los avisos de pago. Opcional: leé
# src/app/api/mp/webhook/route.ts antes de cargarla.
# MP_WEBHOOK_SECRET=

# Solo DESARROLLO: un Mercado Pago de mentira para probar los cobros en la PC
# (scripts/mp-falso.mjs). La app lo acepta solo con SUPABASE_ENTORNO=desarrollo
# y apuntando a esta PC. En producción no se cargan.
# MP_API_URL=http://127.0.0.1:3999
# MP_AUTH_URL=http://127.0.0.1:3999/authorization

# ─── APP URL ─────────────────────────────────────────────────────────────────
# URL pública del sitio (sin barra al final). La usan los cobros (la vuelta de
# Mercado Pago, su aviso de pago y la vuelta de conectar una cuenta). En
# producción es obligatoria: sin ella ningún local cobra online.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://firebrick-giraffe-301726.hostingersite.com

# ─── SUPABASE ────────────────────────────────────────────────────────────────
# Encontrás estos valores en: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ─── BASE DE DATOS (solo para los scripts de scripts/) ───────────────────────
# Conexión directa a Postgres. La app no la usa: solo migrate.mjs,
# exportar-esquema.mjs y preparar-desarrollo.mjs.
#   - Supabase local (desarrollo): postgresql://postgres:postgres@127.0.0.1:54322/postgres
#   - Supabase en la nube: botón "Connect" → "Session pooler" → copiá la URI y
#     reemplazá [YOUR-PASSWORD] por la contraseña de la base.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ¿A qué base apunta este archivo? desarrollo | produccion
#   desarrollo → .env.local            (Supabase local en la PC: se construye y se prueba)
#   produccion → .env.produccion.local (proyecto finos-barbers: demo, web de 369 y producto)
# Los scripts que ESCRIBEN en la base solo corren solos si dice "desarrollo".
# Para producción hay que pedirlo a propósito con --produccion.
SUPABASE_ENTORNO=desarrollo

# Cuenta de admin de prueba que crea scripts/preparar-desarrollo.mjs.
# Solo en el archivo de desarrollo. Inventá un mail y una clave de prueba.
DEV_ADMIN_EMAIL=admin.prueba@example.com
DEV_ADMIN_PASSWORD=una_clave_de_prueba

# ─── RESEND (emails transaccionales) ─────────────────────────────────────────
# Creá tu API key en: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key

# ─── MERCADOPAGO (token simple — respaldo) ───────────────────────────────────
# Respaldo si el comercio NO conectó por OAuth. Usá TEST para desarrollo.
# Encontralo en: https://www.mercadopago.com.ar/developers/panel/app
MERCADOPAGO_ACCESS_TOKEN=TEST-your_mercadopago_access_token

# ─── MERCADOPAGO CONNECT (OAuth — recomendado) ───────────────────────────────
# App de Mercado Pago de la PLATAFORMA (Andretta Studio), no la del comercio.
# Panel de developers → Tus integraciones → Crear aplicación → Credenciales/OAuth.
# Configurá la Redirect URI: <NEXT_PUBLIC_SITE_URL>/api/mp/oauth/callback
MP_CLIENT_ID=your_mp_application_id
MP_CLIENT_SECRET=your_mp_client_secret

# ─── APP URL ─────────────────────────────────────────────────────────────────
# URL pública del sitio (sin trailing slash). Usada para el redirect de OAuth.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://firebrick-giraffe-301726.hostingersite.com
